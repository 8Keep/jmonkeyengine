MaterialDef Original Conifer {
    MaterialParameters {
        Texture2D FrondTexture
        Float AlphaDiscardThreshold : 0.42
        Int ConiferBakeMode : 0
        Vector3 ConiferBakeToObserver : 0.0 0.0 1.0
        Boolean UseConiferLodFade : false
        Color SunColor : 4.08407 3.70708 3.01593 1.0
        Color AmbientColor : 0.34 0.39 0.31 1.0
        // Transmission relative to albedo, capped by remaining energy; zero is opaque.
        Float FoliageTransmission : 0.18
        Vector3 SunDirection : -0.35 -0.82 -0.45
        Boolean UseConiferInstances : false
        Boolean UseHeightfieldSkyIrradiance : false
        Vector3Array SkyIrradianceSH

        Boolean UseDirectionalVisibility : false
        Boolean DirectionalHardwareShadows : false
        Int DirectionalCascadeCount : 1
        Float DirectionalShadowMapSize : 1024.0
        Float DirectionalShadowBias : 0.0005
        Float DirectionalShadowStrength : 1.0
        Color DirectionalShadowSplits
        Vector3 DirectionalShadowLightDir
        Vector2 DirectionalShadowFade
        Texture2D DirectionalShadowMap0
        Texture2D DirectionalShadowMap1
        Texture2D DirectionalShadowMap2
        Texture2D DirectionalShadowMap3
        Matrix4 DirectionalLightViewProjectionMatrix0
        Matrix4 DirectionalLightViewProjectionMatrix1
        Matrix4 DirectionalLightViewProjectionMatrix2
        Matrix4 DirectionalLightViewProjectionMatrix3
    }

    Technique {
        LightMode SinglePassAndImageBased

        VertexShader GLSL300 GLSL150: Common/MatDefs/Terrain/Forest/OriginalConifer.vert
        FragmentShader GLSL300 GLSL150: Common/MatDefs/Terrain/Forest/OriginalConifer.frag

        WorldParameters {
            WorldViewProjectionMatrix
            WorldMatrix
            WorldNormalMatrix
            ViewMatrix
        }

        Defines {
            DIRECTIONAL_VISIBILITY : UseDirectionalVisibility
            DIRECTIONAL_HARDWARE_SHADOWS : DirectionalHardwareShadows
            CONIFER_INSTANCING : UseConiferInstances
            CONIFER_SKY_IRRADIANCE : UseHeightfieldSkyIrradiance
            CONIFER_BAKE_MODE : ConiferBakeMode
            CONIFER_LOD_FADE : UseConiferLodFade
        }
    }

    // The forced shadow pass uses the same UV.z leaf tag as the visible pass,
    // so transparent holes in fronds do not become solid depth silhouettes.
    Technique PreShadow {
        VertexShader GLSL300 GLSL150: Common/MatDefs/Terrain/Forest/OriginalConiferPreShadow.vert
        FragmentShader GLSL300 GLSL150: Common/MatDefs/Terrain/Forest/OriginalConiferPreShadow.frag

        WorldParameters {
            WorldViewProjectionMatrix
        }

        Defines {
            CONIFER_INSTANCING : UseConiferInstances
            CONIFER_LOD_FADE : UseConiferLodFade
        }

        ForcedRenderState {
            FaceCull Back
            DepthTest On
            DepthWrite On
            PolyOffset 5 3
            ColorWrite Off
        }
    }
}
