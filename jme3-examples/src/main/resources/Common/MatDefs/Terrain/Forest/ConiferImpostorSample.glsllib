#import "Common/MatDefs/Terrain/Forest/ConiferImpostorData.glsllib"
#import "Common/MatDefs/Terrain/Forest/ConiferImpostorFrames.glsllib"
#import "Common/MatDefs/Terrain/Forest/ConiferLodFade.glsllib"
#ifdef GL_ES
precision highp sampler2DArray;
#endif
uniform sampler2DArray m_ConiferColorFrames;
uniform sampler2DArray m_ConiferNormalDepthFrames;
uniform mat4 g_WorldViewProjectionMatrix;
uniform mat4 g_WorldMatrix;
uniform mat3 g_WorldNormalMatrix;
uniform mat4 g_ProjectionMatrix;
uniform float m_AlphaDiscardThreshold;
varying vec3 vPlanePoint;
flat varying vec3 vObserverDirection;
flat varying vec3 vLocalEye;
flat varying vec4 vPositionScale;
flat varying vec3 vYawTint;
flat varying float vConiferLodWeight;

vec3 ConiferYaw(vec3 point) {
    return vec3(vYawTint.x * point.x + vYawTint.y * point.z, point.y,
               -vYawTint.y * point.x + vYawTint.x * point.z);
}
vec2 ConiferFrameUV(vec3 point, ConiferFrame frame) {
    vec3 offset = point - coniferCenter.xyz;
    return vec2(dot(offset, frame.rightHalfWidth.xyz) / (2.0 * frame.rightHalfWidth.w),
                dot(offset, frame.upHalfHeight.xyz) / (2.0 * frame.upHalfHeight.w)) + vec2(0.5);
}
// Return unlit linear albedo, object normal and reconstructed world position.
// Both opaque color and PreShadow invoke this exact coverage/depth kernel.
void ConiferReconstruct(out vec3 albedo, out vec3 worldNormal, out vec3 worldPosition) {
    vec3 pointDx = dFdx(vPlanePoint), pointDy = dFdy(vPlanePoint);
    ConiferFarFade(vConiferLodWeight);
    ivec3 ids;
    vec3 weights;
    if (!ConiferSelectFrames(vObserverDirection, ids, weights)) discard;
    bool parallel = g_ProjectionMatrix[3][3] == 1.0;
    vec3 ray = parallel ? vObserverDirection : normalize(vLocalEye - vPlanePoint);
    vec4 accumulatedColor = vec4(0.0);
    vec3 accumulatedNormal = vec3(0.0);
    float accumulatedDistance = 0.0;
    for (int view = 0; view < 3; view++) {
        ConiferFrame frame = coniferFrames[ids[view]];
        vec2 uvDx = vec2(dot(pointDx, frame.rightHalfWidth.xyz) / (2.0 * frame.rightHalfWidth.w),
                        dot(pointDx, frame.upHalfHeight.xyz) / (2.0 * frame.upHalfHeight.w));
        vec2 uvDy = vec2(dot(pointDy, frame.rightHalfWidth.xyz) / (2.0 * frame.rightHalfWidth.w),
                        dot(pointDy, frame.upHalfHeight.xyz) / (2.0 * frame.upHalfHeight.w));
        float distanceAlongRay = 0.0;
        float denominator = max(0.15, dot(ray, frame.direction.xyz));
        vec2 uv = ConiferFrameUV(vPlanePoint, frame);
        for (int iteration = 0; iteration < 2; iteration++) {
            vec4 c = textureGrad(m_ConiferColorFrames, vec3(uv, float(ids[view])), uvDx, uvDy);
            vec4 nd = textureGrad(m_ConiferNormalDepthFrames, vec3(uv, float(ids[view])), uvDx, uvDy);
            float depth = c.a > 1e-5 ? nd.a / c.a : 0.0;
            distanceAlongRay = (depth - dot(vPlanePoint - coniferCenter.xyz, frame.direction.xyz)) / denominator;
            uv = ConiferFrameUV(vPlanePoint + ray * distanceAlongRay, frame);
        }
        vec4 c = textureGrad(m_ConiferColorFrames, vec3(uv, float(ids[view])), uvDx, uvDy);
        vec4 nd = textureGrad(m_ConiferNormalDepthFrames, vec3(uv, float(ids[view])), uvDx, uvDy);
        if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) c = vec4(0.0);
        accumulatedColor += c * weights[view];
        accumulatedNormal += nd.xyz * c.a * weights[view] / max(c.a, 1e-5);
        accumulatedDistance += distanceAlongRay * c.a * weights[view];
    }
    if (accumulatedColor.a <= m_AlphaDiscardThreshold) discard;
    albedo = accumulatedColor.rgb / accumulatedColor.a;
    vec3 objectNormal = dot(accumulatedNormal, accumulatedNormal) > 1e-10
            ? normalize(accumulatedNormal) : vObserverDirection;
    worldNormal = normalize(g_WorldNormalMatrix * ConiferYaw(objectNormal));
    vec3 objectPosition = vPlanePoint + ray * (accumulatedDistance / accumulatedColor.a);
    vec3 sourcePosition = ConiferYaw(objectPosition) * vPositionScale.w + vPositionScale.xyz;
    worldPosition = (g_WorldMatrix * vec4(sourcePosition, 1.0)).xyz;
    vec4 clip = g_WorldViewProjectionMatrix * vec4(sourcePosition, 1.0);
    // Preserve fixed-function polygon offset (notably in the shadow pass)
    // while replacing the flat card's surface depth with the reconstructed hit.
    vec3 planeSource = ConiferYaw(vPlanePoint) * vPositionScale.w + vPositionScale.xyz;
    vec4 planeClip = g_WorldViewProjectionMatrix * vec4(planeSource, 1.0);
    float rasterOffset = gl_FragCoord.z - ((planeClip.z / planeClip.w) * 0.5 + 0.5);
    gl_FragDepth = (clip.z / clip.w) * 0.5 + 0.5 + rasterOffset;
}
