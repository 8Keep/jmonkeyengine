#ifndef ATMOSPHERE_TRANSPORT_GLSLLIB
#define ATMOSPHERE_TRANSPORT_GLSLLIB

const float ATMOSPHERE_PI = 3.14159265358979323846;

// Map a unit-range LUT coordinate to texel centers. This matches the inverse
// mapping used while rendering each LUT, including both logical endpoints.
vec2 AtmosphereUvFromUnitRange(vec2 value, ivec2 size) {
    vec2 extent = vec2(size);
    return (vec2(0.5) + clamp(value, vec2(0.0), vec2(1.0)) * (extent - vec2(1.0))) / extent;
}

vec2 AtmosphereUnitRangeFromRaster(vec2 uv, ivec2 size) {
    vec2 extent = vec2(size);
    return clamp((uv * extent - vec2(0.5)) / (extent - vec2(1.0)), vec2(0.0), vec2(1.0));
}

float AtmosphereAltitude(float radius, vec2 radii) {
    return max(radius - radii.x, 0.0);
}

vec3 AtmosphereDensity(float radius, vec2 radii, vec4 rayleigh, vec4 mie) {
    float altitude = AtmosphereAltitude(radius, radii);
    return vec3(exp(-altitude / rayleigh.w), exp(-altitude / mie.z), 0.0);
}

vec3 AtmosphereExtinction(vec3 density, vec4 rayleigh, vec4 mie) {
    return rayleigh.rgb * density.x + vec3(mie.y * density.y);
}

vec3 AtmosphereScattering(vec3 density, vec4 rayleigh, vec4 mie) {
    return rayleigh.rgb * density.x + vec3(mie.x * density.y);
}

float AtmosphereRayleighPhase(float cosineAngle) {
    float c = clamp(cosineAngle, -1.0, 1.0);
    return 3.0 * (1.0 + c * c) / (16.0 * ATMOSPHERE_PI);
}

float AtmosphereMiePhase(float cosineAngle, float g) {
    float c = clamp(cosineAngle, -1.0, 1.0);
    float g2 = g * g;
    float denominator = max(1.0e-12, 1.0 + g2 - 2.0 * g * c);
    return 3.0 * (1.0 - g2) * (1.0 + c * c)
            / (8.0 * ATMOSPHERE_PI * (2.0 + g2) * pow(denominator, 1.5));
}

bool AtmosphereRayHitsGround(float radius, float cosineZenith, vec2 radii) {
    if (cosineZenith >= 0.0) return false;
    float b = radius * cosineZenith;
    float groundOffset = (radii.x - radius) * (radii.x + radius);
    float discriminant = b * b + groundOffset;
    return discriminant >= 0.0;
}

// Distance to the top sphere's forward intersection. The rationalized outward
// branch avoids subtracting nearly equal radii for a near-vertical ray.
float AtmosphereDistanceToTop(float radius, float cosineZenith, vec2 radii) {
    float b = radius * cosineZenith;
    float c = (radii.y - radius) * (radii.y + radius);
    float discriminant = max(0.0, b * b + c);
    float root = sqrt(discriminant);
    if (b >= 0.0) return c / max(root + b, 1.0e-12);
    return -b + root;
}

// The first ground intersection for a ray known to point into the planet.
float AtmosphereDistanceToGround(float radius, float cosineZenith, vec2 radii) {
    float b = radius * cosineZenith;
    float c = (radii.x - radius) * (radii.x + radius);
    float discriminant = max(0.0, b * b + c);
    float root = sqrt(discriminant);
    // For an observer above the surface, the near intersection subtracts
    // nearly equal radii. Use the product of the two roots instead.
    if (b < 0.0 && c < 0.0) return max(0.0, -c / max(root - b, 1.0e-12));
    return max(0.0, -b - root);
}

// Bruneton's rho/distance parameterization of transmittance to the top sphere.
// Ground-intersecting rays are deliberately handled separately by the caller.
vec2 AtmosphereTransmittanceUnit(float radius, float cosineZenith, vec2 radii) {
    float ground = radii.x;
    float top = radii.y;
    float H = sqrt(max(0.0, (top - ground) * (top + ground)));
    float rho = sqrt(max(0.0, (radius - ground) * (radius + ground)));
    float distanceMin = top - radius;
    float distanceMax = rho + H;
    float distance = AtmosphereDistanceToTop(radius, cosineZenith, radii);
    float x = (distance - distanceMin) / max(distanceMax - distanceMin, 1.0e-12);
    float y = rho / max(H, 1.0e-12);
    return clamp(vec2(x, y), vec2(0.0), vec2(1.0));
}

vec2 AtmosphereMultipleScatteringUnit(float cosineSunZenith, float radius, vec2 radii) {
    return clamp(vec2(0.5 + 0.5 * cosineSunZenith,
            (radius - radii.x) / (radii.y - radii.x)), vec2(0.0), vec2(1.0));
}

// Stable integral of exp(-sigma*t) over a constant-coefficient segment.
float AtmosphereSegmentIntegral(float sigma, float distance) {
    float opticalDepth = sigma * distance;
    if (abs(opticalDepth) < 1.0e-3) {
        return distance * (1.0 - 0.5 * opticalDepth + opticalDepth * opticalDepth / 6.0);
    }
    if (sigma == 0.0) return distance;
    return (1.0 - exp(-opticalDepth)) / sigma;
}

vec3 AtmosphereSegmentIntegral(vec3 sigma, float distance) {
    return vec3(AtmosphereSegmentIntegral(sigma.x, distance),
            AtmosphereSegmentIntegral(sigma.y, distance),
            AtmosphereSegmentIntegral(sigma.z, distance));
}

#endif
