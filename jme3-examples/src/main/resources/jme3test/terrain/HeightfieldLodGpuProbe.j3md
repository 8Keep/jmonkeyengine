// Example-only float readback material for the shared heightfield LOD helper.
MaterialDef HeightfieldLodGpuProbe {
    MaterialParameters {
        TextureArray HeightPages -LINEAR
        Int HeightLayer : 0
        Float SampleSpacing : 1.0
        Boolean UseHeightfieldLod : true
        Boolean UseHeightfieldInstances : false
        Boolean UseHeightfieldInstanceMorphs : false
        // Physical node-local halo pages; requires instance records and live bindings.
        Boolean UseHeightfieldNodePages : false
        UniformBufferObject HeightfieldPageBindings
        UniformBufferObject PatchRecords
        Int PatchRecordBase : 0
        Int PatchRecordVectors : 340
        Int PageCells : 0
        Int PatchGridCells : 0
        Vector2 PageLatticeOrigin : 0.0 0.0
        Vector2 PatchLatticeOrigin : 0.0 0.0
        Int SampleStride : 1
        Float InteriorMorph : 0.0
        Float EdgeMorphWest : 0.0
        Float EdgeMorphEast : 0.0
        Float EdgeMorphNorth : 0.0
        Float EdgeMorphSouth : 0.0
    }

    Technique {
        VertexShader GLSL300 GLSL150: jme3test/terrain/HeightfieldLodGpuProbe.vert
        FragmentShader GLSL300 GLSL150: jme3test/terrain/HeightfieldLodGpuProbe.frag

        Defines {
            HEIGHTFIELD_LOD : UseHeightfieldLod
            HEIGHTFIELD_INSTANCES : UseHeightfieldInstances
            HEIGHTFIELD_INSTANCE_MORPHS : UseHeightfieldInstanceMorphs
            HEIGHTFIELD_NODE_PAGES : UseHeightfieldNodePages
            HEIGHTFIELD_PATCH_RECORD_VECS : PatchRecordVectors
        }

        RenderState {
            FaceCull Off
            DepthTest Off
            DepthWrite Off
            Blend Off
        }
    }
}
