layout(local_size_x=128) in;
struct Node {
    ivec4 children;  // child indices; -1 for a leaf
    ivec4 meta;      // level, ready, parent, unused
    vec4 rect;       // originX, originZ, span, stride
    vec4 errors;     // conservative stable and morph pixels, rounded upward
    vec4 boundsMin;
    vec4 boundsMax;
};
layout(std430, binding=0) readonly buffer NodeInput {
    Node nodes[85];
    vec4 planes[6];
    vec4 sourceInfo; // revision, requested pixels, leaf budget, node count
};
layout(std430, binding=1) buffer SelectionOutput {
    vec4 header;     // visible count, saturation bits, total leaf count, source revision
    vec4 records[340]; // cover[85] then compact visible[85], two vec4 per record
};
uniform int m_NodeCount;
uniform int m_MaxLeaves;
uniform float m_TargetPixels;

shared bool cover[85];
shared bool attempted[85];
shared bool proposal[85];
shared bool hasCoarser[85];
shared bool candidateNodes[85];
shared bool unbalanced[85];
shared bool visible[85];
shared float coverErrors[85];
shared int rank[85];
shared int proposalRank[85];
shared int candidate;
shared int splitNode;
shared int coarseNode;
shared int rankCounter;
shared int proposalRankCounter;
shared int leafCount;
shared int flags;
shared int proposedLeaves;
shared int visibleCount;
shared bool accepted;
shared bool finished;

bool touchesNode(int a, int b) {
    vec4 x = nodes[a].rect;
    vec4 y = nodes[b].rect;
    return x.x <= y.x + y.z && y.x <= x.x + x.z
        && x.y <= y.y + y.z && y.y <= x.y + x.z;
}
bool nodeHasCoarserNeighbor(int n) {
    for (int j=0; j<85; ++j) {
        if (j != n && cover[j] && nodes[j].meta.x < nodes[n].meta.x && touchesNode(n,j)) return true;
    }
    return false;
}
bool allChildrenReady(int n) {
    if (nodes[n].children.x < 0) return false;
    for (int k=0; k<4; ++k) if (nodes[nodes[n].children[k]].meta.y == 0) return false;
    return true;
}
bool outsideFrustum(int n) {
    vec3 lo = nodes[n].boundsMin.xyz;
    vec3 hi = nodes[n].boundsMax.xyz;
    vec3 c = (lo + hi) * 0.5;
    vec3 e = (hi - lo) * 0.5;
    for (int p=0; p<6; ++p) {
        vec4 plane = planes[p];
        float maxDistance = dot(plane.xyz, c) + plane.w + dot(abs(plane.xyz), e);
        float pad = 1e-5 * (1.0 + abs(plane.w) + dot(abs(plane.xyz), abs(c) + e));
        if (isnan(maxDistance) || isinf(maxDistance) || isnan(pad) || isinf(pad)) continue;
        if (maxDistance < -pad) return true;
    }
    return false;
}
void main() {
    int lane = int(gl_LocalInvocationID.x);
    int nodeCount = clamp(m_NodeCount, 0, 85);
    if (lane < 85) {
        cover[lane] = false;
        attempted[lane] = false;
        proposal[lane] = false;
        hasCoarser[lane] = false;
        candidateNodes[lane] = false;
        unbalanced[lane] = false;
        visible[lane] = false;
        coverErrors[lane] = 0.0;
        rank[lane] = -1;
        proposalRank[lane] = -1;
    }
    barrier();
    if (lane == 0) {
        cover[0] = true; // pinned root fallback
        rank[0] = 0;
        rankCounter = 1;
        leafCount = 1;
        flags = nodes[0].meta.y == 0 ? 8 : 0;
        finished = false;
    }
    barrier();

    // The original bounded priority loop is unchanged. Lanes parallelize the
    // per-cover neighbor work; lane zero retains the CPU leaf insertion order
    // for ties and serial split/balance mutations.
    for (int pass=0; pass<1870; ++pass) {
        if (lane < 85) hasCoarser[lane] = lane < nodeCount && nodeHasCoarserNeighbor(lane);
        barrier();
        if (lane < 85) {
            coverErrors[lane] = cover[lane]
                    && lane < nodeCount
                    ? (hasCoarser[lane] ? nodes[lane].errors.y : nodes[lane].errors.x)
                    : 0.0;
            candidateNodes[lane] = lane < nodeCount && cover[lane] && !attempted[lane]
                    && coverErrors[lane] > m_TargetPixels;
        }
        barrier();
        if (lane == 0) {
            candidate = -1;
            float worst = m_TargetPixels;
            for (int i=0; i<85; ++i) {
                if (!candidateNodes[i]) continue;
                float error = coverErrors[i];
                if (error > worst || (candidate >= 0 && error == worst && rank[i] < rank[candidate])) {
                    worst = error;
                    candidate = i;
                }
            }
            if (candidate < 0) finished = true;
        }
        barrier();
        if (finished) break;

        if (lane == 0) {
            attempted[candidate] = true;
            splitNode = candidate;
            if (nodes[splitNode].children.x < 0) {
                splitNode = -1;
                for (int j=0; j<85; ++j) {
                    if (j != candidate && cover[j] && nodes[j].meta.x < nodes[candidate].meta.x
                            && touchesNode(candidate,j)
                            && (splitNode < 0 || rank[j] < rank[splitNode])) splitNode = j;
                }
            }
            accepted = false;
            if (splitNode < 0) {
                flags |= 4;
            } else if (leafCount + 3 > m_MaxLeaves) {
                flags |= 1;
                splitNode = -1;
            } else if (!allChildrenReady(splitNode)) {
                flags |= 2;
                splitNode = -1;
            }
        }
        barrier();

        if (splitNode >= 0) {
            if (lane < 85) {
                proposal[lane] = cover[lane];
                proposalRank[lane] = rank[lane];
            }
            barrier();
            if (lane == 0) {
                proposal[splitNode] = false;
                proposalRank[splitNode] = -1;
                proposalRankCounter = rankCounter;
                for (int k=0; k<4; ++k) {
                    int child = nodes[splitNode].children[k];
                    proposal[child] = true;
                    proposalRank[child] = proposalRankCounter++;
                }
                proposedLeaves = leafCount + 3;
                accepted = true;
            }
            barrier();

            for (int balance=0; balance<85; ++balance) {
                if (lane < 85) {
                    bool found = false;
                    if (lane < nodeCount && proposal[lane]) {
                        for (int b=0; b<85; ++b) {
                            if (proposal[b] && touchesNode(lane,b)
                                    && nodes[lane].meta.x + 1 < nodes[b].meta.x) {
                                found = true;
                                break;
                            }
                        }
                    }
                    unbalanced[lane] = found;
                }
                barrier();
                if (lane == 0) {
                    coarseNode = -1;
                    for (int a=0; a<85; ++a) {
                        if (unbalanced[a] && (coarseNode < 0
                                || proposalRank[a] < proposalRank[coarseNode])) coarseNode = a;
                    }
                    if (coarseNode >= 0) {
                        if (proposedLeaves + 3 > m_MaxLeaves) {
                            flags |= 1;
                            accepted = false;
                        } else if (!allChildrenReady(coarseNode)) {
                            flags |= 2;
                            accepted = false;
                        } else {
                            proposal[coarseNode] = false;
                            proposalRank[coarseNode] = -1;
                            for (int k=0; k<4; ++k) {
                                int child = nodes[coarseNode].children[k];
                                proposal[child] = true;
                                proposalRank[child] = proposalRankCounter++;
                            }
                            proposedLeaves += 3;
                            if (balance == 84) accepted = false;
                        }
                    }
                }
                barrier();
                if (!accepted || coarseNode < 0) break;
            }

            if (lane == 0 && accepted) {
                leafCount = proposedLeaves;
                rankCounter = proposalRankCounter;
            }
            barrier();
            if (accepted && lane < 85) {
                cover[lane] = proposal[lane];
                rank[lane] = proposalRank[lane];
                attempted[lane] = false;
            }
            barrier();
        }
    }

    if (lane < 85) hasCoarser[lane] = lane < nodeCount && nodeHasCoarserNeighbor(lane);
    barrier();
    if (lane < 85) {
        coverErrors[lane] = cover[lane] && lane < nodeCount
                ? (hasCoarser[lane] ? nodes[lane].errors.y : nodes[lane].errors.x)
                : 0.0;
    }
    barrier();
    if (lane == 0) {
        if (!finished) {
            for (int i=0; i<85; ++i) {
                if (cover[i] && !attempted[i] && coverErrors[i] > m_TargetPixels) flags |= 16;
            }
        }
        float remainingError = 0.0;
        for (int i=0; i<85; ++i) if (cover[i]) remainingError = max(remainingError, coverErrors[i]);
        if (remainingError <= m_TargetPixels) flags &= ~7;
    }
    barrier();

    vec4 patchOrigin = vec4(0.0);
    vec4 patchDetail = vec4(0.0);
    if (lane < 85) {
        visible[lane] = lane < nodeCount && cover[lane] && !outsideFrustum(lane);
        if (lane < nodeCount && cover[lane]) {
            int edgeMask = 0;
            for (int j=0; j<85; ++j) {
                if (lane == j || !cover[j] || nodes[j].meta.x >= nodes[lane].meta.x) continue;
                if (!touchesNode(lane,j)) continue;
                vec4 a = nodes[lane].rect, b = nodes[j].rect;
                bool zOverlap = max(a.y,b.y) < min(a.y+a.z,b.y+b.z);
                bool xOverlap = max(a.x,b.x) < min(a.x+a.z,b.x+b.z);
                if (zOverlap && a.x == b.x+b.z) edgeMask |= 1;
                else if (zOverlap && a.x+a.z == b.x) edgeMask |= 2;
                else if (xOverlap && a.y == b.y+b.z) edgeMask |= 4;
                else if (xOverlap && a.y+a.z == b.y) edgeMask |= 8;
            }
            int edgeData = edgeMask | (hasCoarser[lane] ? 16 : 0);
            int record = 0;
            for (int j=0; j<lane; ++j) if (cover[j]) ++record;
            float error = coverErrors[lane];
            patchOrigin = vec4(float(lane), nodes[lane].rect.x, nodes[lane].rect.y, nodes[lane].rect.w);
            patchDetail = vec4(nodes[lane].rect.z, float(edgeData), error, sourceInfo.x);
            records[record*2] = patchOrigin;
            records[record*2+1] = patchDetail;
        }
    }
    // Synchronize visibility decisions; each lane retains its own record values
    // for compaction, so no cross-invocation SSBO read is needed.
    barrier();
    if (lane < nodeCount && visible[lane]) {
        int compactRecord = 0;
        for (int j=0; j<lane; ++j) {
            if (visible[j]) ++compactRecord;
        }
        records[170 + compactRecord*2] = patchOrigin;
        records[170 + compactRecord*2+1] = patchDetail;
    }
    barrier();
    if (lane == 0) {
        visibleCount = 0;
        for (int i=0; i<85; ++i) if (visible[i]) ++visibleCount;
        header = vec4(float(visibleCount), float(flags), float(leafCount), sourceInfo.x);
    }
}
