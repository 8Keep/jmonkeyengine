layout(local_size_x=1) in;
layout(std430, binding=1) readonly buffer SelectionInput {
    vec4 header;
    vec4 records[340];
};
layout(std430, binding=2) writeonly buffer IndirectCommand {
    uint words[5];
};
uniform int m_IndexCount;
uniform bool m_CompleteCover;
void main() {
    float count = m_CompleteCover ? header.z : header.x;
    uint instances = uint(clamp(floor(count + 0.5), 0.0, 64.0));
    words[0] = uint(m_IndexCount);
    words[1] = instances;
    words[2] = 0u;
    words[3] = 0u;
    words[4] = 0u;
}
