#ifdef GL_ES
precision highp sampler2DArray;
#endif

// Instance records use the same page uniforms and LOD reconstruction as the
// ordinary path. The caller supplies the matching page/patch uniforms, record
// range, and instance count for each batch.
#ifdef HEIGHTFIELD_INSTANCES
#ifndef HEIGHTFIELD_LOD
#define HEIGHTFIELD_LOD
#endif
layout(std140) uniform m_PatchRecords {
    vec4 heightfieldRecordHeader;
    vec4 heightfieldRecords[HEIGHTFIELD_PATCH_RECORD_VECS];
};
uniform int m_PatchRecordBase;
#ifdef HEIGHTFIELD_CPU_INSTANCES
attribute float inSize;
#endif
int Heightfield_instanceIndex() {
#ifdef HEIGHTFIELD_CPU_INSTANCES
    return int(floor(inSize + 0.5));
#else
    return gl_InstanceID;
#endif
}
#ifdef HEIGHTFIELD_NODE_PAGES
layout(std140) uniform m_HeightfieldPageBindings {
    ivec4 heightfieldPageLayers[85]; // own layer, parent layer, reserved, reserved
};
#endif
#endif

#if defined(HEIGHTFIELD_SOURCE_GRADIENTS) && !defined(HEIGHTFIELD_LOD)
#error HEIGHTFIELD_SOURCE_GRADIENTS requires HEIGHTFIELD_LOD
#endif

uniform sampler2DArray m_HeightPages;
uniform int m_HeightLayer;
uniform float m_SampleSpacing;
#ifdef HEIGHTFIELD_SOURCE_GRADIENTS
uniform sampler2DArray m_HeightGradientPages;
// Canonical fine-sample spacing, independent of this decimated page's spacing.
uniform float m_SourceSampleSpacing;
#endif

#ifdef HEIGHTFIELD_LOD
// PageLatticeOrigin is integer-valued and exactly representable in a float.
// Patch vertices are integer grid coordinates; together these identify source
// samples independently of the page-local texture coordinates.
uniform vec2 m_PageLatticeOrigin;
uniform vec2 m_PatchLatticeOrigin;
uniform int m_PageCells;
uniform int m_PatchGridCells;
uniform int m_SampleStride;
uniform float m_InteriorMorph;
// Edge order is West (-X), East (+X), North (+Z), South (-Z).
uniform float m_EdgeMorphWest;
uniform float m_EdgeMorphEast;
uniform float m_EdgeMorphNorth;
uniform float m_EdgeMorphSouth;
#endif

float Heightfield_readHeight(ivec2 latticePoint) {
    // Grid vertices address the interior. The added one selects the first
    // vertex sample after the low-side halo; high-side halo lies at cells + 2.
    ivec2 pageTexel = latticePoint + ivec2(1);
    return texelFetch(m_HeightPages, ivec3(pageTexel, m_HeightLayer), 0).r;
}

#ifdef HEIGHTFIELD_LOD
ivec2 Heightfield_pageOrigin() {
    return ivec2(m_PageLatticeOrigin);
}

ivec2 Heightfield_readablePageGrid(ivec2 globalGrid) {
    // The page carries a one-sample halo. Clamp to its valid address range so
    // malformed/misaligned metadata cannot form an out-of-range texelFetch.
    return clamp(globalGrid - Heightfield_pageOrigin(), ivec2(-1),
                 ivec2(m_PageCells + 1));
}

float Heightfield_readGlobalHeight(ivec2 globalGrid) {
    return Heightfield_readHeight(Heightfield_readablePageGrid(globalGrid));
}

#ifdef HEIGHTFIELD_NODE_PAGES
vec4 Heightfield_instancePatch() {
#ifdef HEIGHTFIELD_INSTANCE_MORPHS
    return heightfieldRecords[m_PatchRecordBase + 4 * Heightfield_instanceIndex()];
#else
    return heightfieldRecords[m_PatchRecordBase + 2 * Heightfield_instanceIndex()];
#endif
}

float Heightfield_readNodeHeight(ivec2 nodeGrid, int layer) {
    ivec2 safeGrid = clamp(nodeGrid, ivec2(-1), ivec2(m_PatchGridCells + 1));
    return texelFetch(m_HeightPages, ivec3(safeGrid + ivec2(1), layer), 0).r;
}
#endif

// Gradients share canonical spacing even when a physical node page is decimated.
vec3 Heightfield_lodGradient(ivec2 globalGrid, bool parent) {
#ifdef HEIGHTFIELD_NODE_PAGES
    vec4 patchRecord = Heightfield_instancePatch();
    int node = int(patchRecord.x);
    int stride = int(patchRecord.w);
    ivec2 origin = ivec2(patchRecord.yz);
    int layer = heightfieldPageLayers[node].x;
#ifndef HEIGHTFIELD_CPU_INSTANCES
    if (parent && node != 0) {
        int span = m_PatchGridCells * stride * 2;
        origin = (origin / span) * span;
        stride *= 2;
        layer = heightfieldPageLayers[node].y;
    }
#endif
    ivec2 grid = (globalGrid - Heightfield_pageOrigin() - origin) / stride;
#ifdef HEIGHTFIELD_SOURCE_GRADIENTS
    // RG stores canonical half-height differences, without node-stride division.
    ivec2 gradientTexel = clamp(grid, ivec2(-1), ivec2(m_PatchGridCells + 1)) + ivec2(1);
    vec2 canonicalGradient = texelFetch(m_HeightGradientPages,
            ivec3(gradientTexel, layer), 0).rg;
    return vec3(canonicalGradient.x, m_SampleSpacing, canonicalGradient.y);
#else
    float left = Heightfield_readNodeHeight(grid + ivec2(-1, 0), layer);
    float right = Heightfield_readNodeHeight(grid + ivec2(1, 0), layer);
    float back = Heightfield_readNodeHeight(grid + ivec2(0, -1), layer);
    float front = Heightfield_readNodeHeight(grid + ivec2(0, 1), layer);
    return vec3((left * 0.5 - right * 0.5) / float(stride), m_SampleSpacing,
                (back * 0.5 - front * 0.5) / float(stride));
#endif
#else
#ifdef HEIGHTFIELD_SOURCE_GRADIENTS
    // Ordinary per-node LOD uses one layer for both surfaces. The child's
    // canonical gradient page contains its shared parent coordinates too.
    ivec2 gradientGrid = Heightfield_readablePageGrid(globalGrid);
    vec2 canonicalGradient = texelFetch(m_HeightGradientPages,
            ivec3(gradientGrid + ivec2(1), m_HeightLayer), 0).rg;
    return vec3(canonicalGradient.x, m_SourceSampleSpacing, canonicalGradient.y);
#else
    float left = Heightfield_readGlobalHeight(globalGrid + ivec2(-1, 0));
    float right = Heightfield_readGlobalHeight(globalGrid + ivec2(1, 0));
    float back = Heightfield_readGlobalHeight(globalGrid + ivec2(0, -1));
    float front = Heightfield_readGlobalHeight(globalGrid + ivec2(0, 1));
    return vec3(left * 0.5 - right * 0.5, m_SampleSpacing,
                back * 0.5 - front * 0.5);
#endif
#endif
}

int Heightfield_floorDiv(int value, int divisor) {
    // Keep division operands nonnegative. -(value + 1) remains representable
    // even at INT_MIN, and -1-floor((-value-1)/d) is floor(value/d).
    return value >= 0 ? value / divisor : -1 - (-(value + 1)) / divisor;
}

ivec2 Heightfield_parentGrid(ivec2 globalGrid, int parentStride) {
    return ivec2(Heightfield_floorDiv(globalGrid.x, parentStride),
                 Heightfield_floorDiv(globalGrid.y, parentStride)) * parentStride;
}

float Heightfield_mixFinite(float first, float second, float alpha) {
    // Match the CPU contract: retain exact endpoints/equal values, then clamp
    // the rounded product-sum back to the finite endpoint hull.
    if (alpha == 0.0) {
        return first;
    }
    if (alpha == 1.0) {
        return second;
    }
    if (first == second) {
        return first;
    }
    float mixed = first * (1.0 - alpha) + second * alpha;
    float low = min(first, second);
    float high = max(first, second);
    if (mixed < low) {
        return low;
    }
    if (mixed > high) {
        return high;
    }
    return mixed;
}

// Explicit parameters let ordinary uniforms and GPU instance records share
// exactly the same corner/edge reconstruction. Edge order: west/east/south/north.
float Heightfield_vertexMorph(ivec2 patchVertex, int gridCells,
                             float interiorMorph, vec4 edgeMorph) {
    // Patch corners are shared source vertices and never collapse.
    if ((patchVertex.x == 0 || patchVertex.x == gridCells)
            && (patchVertex.y == 0 || patchVertex.y == gridCells)) {
        return 0.0;
    }

    float alpha = interiorMorph;
    if (patchVertex.x == 0) {
        alpha = max(alpha, edgeMorph.x);
    }
    if (patchVertex.x == gridCells) {
        alpha = max(alpha, edgeMorph.y);
    }
    if (patchVertex.y == gridCells) {
        alpha = max(alpha, edgeMorph.w);
    }
    if (patchVertex.y == 0) {
        alpha = max(alpha, edgeMorph.z);
    }
    return alpha;
}

float Heightfield_vertexMorph(ivec2 patchVertex) {
    return Heightfield_vertexMorph(patchVertex, m_PatchGridCells, m_InteriorMorph,
            vec4(m_EdgeMorphWest, m_EdgeMorphEast, m_EdgeMorphSouth, m_EdgeMorphNorth));
}

vec3 Heightfield_lodPosition(ivec2 patchVertex, ivec2 patchOrigin, int stride,
                            int gridCells, float interiorMorph, vec4 edgeMorph,
                            out ivec2 globalGrid, out ivec2 safeParentGlobal,
                            out float alpha) {
    ivec2 pageOrigin = Heightfield_pageOrigin();
    globalGrid = pageOrigin + patchOrigin + patchVertex * stride;

    int parentStride = stride * 2;
    ivec2 parentGlobal = Heightfield_parentGrid(globalGrid, parentStride);
    // A correctly aligned page + patch origin keeps the parent sample inside
    // the page. Clamp only as a safety guard for invalid metadata, and use the
    // same clamped lattice coordinate for position and height.
    safeParentGlobal = clamp(parentGlobal, pageOrigin,
                                   pageOrigin + ivec2(m_PageCells));
    alpha = Heightfield_vertexMorph(patchVertex, gridCells, interiorMorph, edgeMorph);

    vec2 localFine = vec2(globalGrid - pageOrigin) * m_SampleSpacing;
    vec2 localParent = vec2(safeParentGlobal - pageOrigin) * m_SampleSpacing;
#ifdef HEIGHTFIELD_NODE_PAGES
    int layer = heightfieldPageLayers[int(Heightfield_instancePatch().x)].x;
    float fineHeight = Heightfield_readNodeHeight(patchVertex, layer);
    ivec2 parentNodeGrid = (safeParentGlobal - pageOrigin - patchOrigin) / stride;
    float parentHeight = Heightfield_readNodeHeight(parentNodeGrid, layer);
#else
    float fineHeight = Heightfield_readGlobalHeight(globalGrid);
    float parentHeight = Heightfield_readGlobalHeight(safeParentGlobal);
#endif
    return vec3(Heightfield_mixFinite(localFine.x, localParent.x, alpha),
                Heightfield_mixFinite(fineHeight, parentHeight, alpha),
                Heightfield_mixFinite(localFine.y, localParent.y, alpha));
}

vec3 Heightfield_lodPosition(ivec2 patchVertex, ivec2 patchOrigin, int stride,
                            int gridCells, float interiorMorph, vec4 edgeMorph,
                            out ivec2 globalGrid) {
    ivec2 parentGrid;
    float alpha;
    return Heightfield_lodPosition(patchVertex, patchOrigin, stride, gridCells,
            interiorMorph, edgeMorph, globalGrid, parentGrid, alpha);
}

vec3 Heightfield_lodPosition(ivec2 patchVertex, out ivec2 globalGrid,
                            out ivec2 parentGrid, out float alpha) {
#ifdef HEIGHTFIELD_INSTANCES
#ifdef HEIGHTFIELD_INSTANCE_MORPHS
    int firstRecord = m_PatchRecordBase + 4 * Heightfield_instanceIndex();
    // Four-vec4 layout: node/origin/stride, span/flags/error/revision,
    // interior/west/east/south weights, then north weight.
    vec4 patchData = heightfieldRecords[firstRecord];
    vec4 morphWeights = heightfieldRecords[firstRecord + 2];
    vec4 northMorph = heightfieldRecords[firstRecord + 3];
    vec4 edgeMorph = vec4(morphWeights.y, morphWeights.z, morphWeights.w, northMorph.x);
    return Heightfield_lodPosition(patchVertex, ivec2(patchData.y, patchData.z), int(patchData.w),
            m_PatchGridCells, morphWeights.x, edgeMorph, globalGrid, parentGrid, alpha);
#else
    int firstRecord = m_PatchRecordBase + 2 * Heightfield_instanceIndex();
    // Pair layout: id/originX/originZ/stride, then span/edgeBits/error/revision.
    vec4 patchData = heightfieldRecords[firstRecord];
    vec4 details = heightfieldRecords[firstRecord + 1];
    int edgeBits = int(details.y);
    vec4 edgeMorph = vec4(
            (edgeBits & 1) != 0 ? 1.0 : 0.0,
            (edgeBits & 2) != 0 ? 1.0 : 0.0,
            (edgeBits & 4) != 0 ? 1.0 : 0.0,
            (edgeBits & 8) != 0 ? 1.0 : 0.0);
    return Heightfield_lodPosition(patchVertex, ivec2(patchData.y, patchData.z), int(patchData.w),
            m_PatchGridCells, 0.0, edgeMorph, globalGrid, parentGrid, alpha);
#endif
#else
    return Heightfield_lodPosition(patchVertex, ivec2(m_PatchLatticeOrigin), m_SampleStride,
            m_PatchGridCells, m_InteriorMorph,
            vec4(m_EdgeMorphWest, m_EdgeMorphEast, m_EdgeMorphSouth, m_EdgeMorphNorth),
            globalGrid, parentGrid, alpha);
#endif
}

vec3 Heightfield_lodPosition(ivec2 patchVertex, out ivec2 globalGrid) {
    ivec2 parentGrid;
    float alpha;
    return Heightfield_lodPosition(patchVertex, globalGrid, parentGrid, alpha);
}
#endif
