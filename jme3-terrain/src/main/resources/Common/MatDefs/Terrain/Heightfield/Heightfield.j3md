// GPU-displaced terrain backed by R32F height pages with a one-texel halo.
MaterialDef Heightfield {
    MaterialParameters {
        // Each array layer stores (cells + 3) x (cells + 3) samples: cells+1
        // vertex samples plus one neighbor-halo sample on every side.
        TextureArray HeightPages -LINEAR
        Int HeightLayer : 0
        // Must match HeightfieldPage.getSampleSpacing() used to create the mesh
        // bound. Positive and finite; shared by main and depth vertex passes.
        Float SampleSpacing : 1.0

        // Optional CPU-selected patch LOD. When enabled, the vertex grid uses
        // integer patch coordinates and samples the global source lattice.
        Boolean UseHeightfieldLod : false
        // Instance records default to two vec4s per patch after the header;
        // UseHeightfieldInstanceMorphs enables four vec4s per patch. The caller
        // owns the range/count and keeps page/patch uniforms uniform per batch.
        Boolean UseHeightfieldInstances : false
        Boolean UseHeightfieldInstanceMorphs : false
        // CPU-remapped instance ordinals from the per-instance Size buffer.
        Boolean UseHeightfieldCpuInstances : false
        // Physical node-local halo pages; requires instance records and live bindings.
        Boolean UseHeightfieldNodePages : false
        // Optional canonical height-slope samples aligned with node-page layers.
        // RG stores canonical half-height differences dx,dz. Node-page gradients
        // use SampleSpacing; ordinary per-node LOD materials use this canonical
        // source spacing for the normal's vertical component.
        Boolean UseHeightfieldSourceGradients : false
        TextureArray HeightGradientPages -LINEAR
        // Positive finite spacing of the canonical fine source samples. Required
        // when source gradients are enabled on ordinary (non-instance) LOD pages.
        Float SourceSampleSpacing : 1.0
        UniformBufferObject HeightfieldPageBindings
        UniformBufferObject PatchRecords
        // Offset in vec4 record units (the header is outside this array).
        Int PatchRecordBase : 0
        // Compile-time vec4 capacity after the header. The default holds two
        // 85-patch two-vec4 ranges, or one 85-patch four-vec4 morph range.
        Int PatchRecordVectors : 340
        // Fine-lattice cell dimensions of the page layer and this draw patch.
        Int PageCells : 0
        Int PatchGridCells : 0
        // Integer-valued origins: global source origin, then patch offset within page.
        // For the CPU hierarchy contract, PageLatticeOrigin must be aligned to
        // the power-of-two PageCells lattice. An arbitrary offset changes the
        // shader's global parent snap and is not supported by that hierarchy.
        Vector2 PageLatticeOrigin : 0.0 0.0
        Vector2 PatchLatticeOrigin : 0.0 0.0
        Int SampleStride : 1
        Float InteriorMorph : 0.0
        // Edge order: West (-X), East (+X), North (+Z), South (-Z).
        Float EdgeMorphWest : 0.0
        Float EdgeMorphEast : 0.0
        Float EdgeMorphNorth : 0.0
        Float EdgeMorphSouth : 0.0

        // Linear-space surface colors. The shader returns linear HDR values.
        Color GrassColor : 0.18 0.28 0.12 1.0
        Color RockColor : 0.24 0.23 0.21 1.0
        Color SnowColor : 0.78 0.84 0.88 1.0
        Float Roughness : 0.88

        // Optional diffuse sky irradiance from nine prepared world-space SH
        // coefficients. Replaces artistic ambient fill on the first light pass.
        Boolean UseHeightfieldSkyIrradiance : false
        Vector3Array SkyIrradianceSH

        // World-space breakup frequency and configurable snow elevation band.
        Float TextureScale : 0.035
        Float SnowLine : 120.0
        Float SnowFade : 18.0

        // Optional material pages; geometry and material quality are independent.
        // Each logical mip has its own array layer, with world-neighbor gutters.
        Boolean UseHeightfieldSurface : false
        TextureArray SurfaceAlbedoPages -LINEAR
        TextureArray SurfaceNormalPages -LINEAR
        TextureArray SurfaceSemanticPages -LINEAR
        Texture2D SurfacePageTable -LINEAR
        Int SurfacePhysicalSide : 36
        Int SurfaceGutter : 2
        Int SurfaceMipCount : 3
        // Optional procedural fallback outside a bounded material-page region.
        Boolean UseHeightfieldSurfaceRegionFallback : false
        Float SurfaceRegionFade : 64.0
        // Optional original/image-backed detail for the procedural rock blend.
        Texture2D RockDetailMap
        // Optional scalar rock relief in metres; shares the triplanar detail scale.
        Texture2D RockHeightMap -LINEAR
        Float RockHeightMetres : 0.0
        Vector3 RockDetailMean : 1.0 1.0 1.0
        Float RockDetailWorldScale : 0.0625
        Float RockDetailStrength : 0.45
        Vector2 SurfaceRegionOrigin : 0.0 0.0
        Float SurfaceRegionSize : 64.0
        Float SurfaceCanonicalSpacing : 0.5
        TextureArray SurfaceSourceAlbedo -LINEAR
        TextureArray SurfaceSourceNormal -LINEAR
        Texture2D SurfaceSourceWeights -LINEAR
        Vector2 SurfaceSourceOriginFine : -64.0 -64.0
        // Direct composition and exact taps are diagnostic alternatives.
        Boolean SurfaceDirectReference : false
        Boolean SurfacePreciseFilter : false
        Float SurfaceFixedLod : -1.0

        // Optional four-cascade directional visibility for one designated sun.
        Boolean UseDirectionalVisibility : false
        Boolean DirectionalHardwareShadows : false
        Int DirectionalCascadeCount : 1
        Float DirectionalShadowMapSize : 1024.0
        Float DirectionalShadowBias : 0.0005
        Float DirectionalShadowStrength : 1.0
        Color DirectionalShadowSplits : 100.0 300.0 900.0 3000.0
        Vector3 DirectionalShadowLightDir
        Vector2 DirectionalShadowFade : 0.0 0.0
        Texture2D DirectionalShadowMap0
        Texture2D DirectionalShadowMap1
        Texture2D DirectionalShadowMap2
        Texture2D DirectionalShadowMap3
        Matrix4 DirectionalLightViewProjectionMatrix0
        Matrix4 DirectionalLightViewProjectionMatrix1
        Matrix4 DirectionalLightViewProjectionMatrix2
        Matrix4 DirectionalLightViewProjectionMatrix3

    }

    Technique {
        // PBR helpers consume world-space light vectors. Ordinary SinglePass
        // uploads view-space lights and would rotate the sun with the camera.
        LightMode SinglePassAndImageBased

        VertexShader GLSL300 GLSL150: Common/MatDefs/Terrain/Heightfield/Heightfield.vert
        FragmentShader GLSL300 GLSL150: Common/MatDefs/Terrain/Heightfield/Heightfield.frag

        WorldParameters {
            WorldViewProjectionMatrix
            WorldMatrix
            WorldNormalMatrix
            CameraPosition
            ViewMatrix
        }

        Defines {
            HEIGHTFIELD_LOD : UseHeightfieldLod
            HEIGHTFIELD_INSTANCES : UseHeightfieldInstances
            HEIGHTFIELD_INSTANCE_MORPHS : UseHeightfieldInstanceMorphs
            HEIGHTFIELD_CPU_INSTANCES : UseHeightfieldCpuInstances
            HEIGHTFIELD_NODE_PAGES : UseHeightfieldNodePages
            HEIGHTFIELD_SOURCE_GRADIENTS : UseHeightfieldSourceGradients
            HEIGHTFIELD_PATCH_RECORD_VECS : PatchRecordVectors
            HEIGHTFIELD_SURFACE : UseHeightfieldSurface
            SURFACE_REGION_FALLBACK : UseHeightfieldSurfaceRegionFallback
            ROCK_DETAIL : RockDetailMap
            ROCK_HEIGHT : RockHeightMap
            SURFACE_DIRECT_REFERENCE : SurfaceDirectReference
            SURFACE_PRECISE_FILTER : SurfacePreciseFilter
            DIRECTIONAL_VISIBILITY : UseDirectionalVisibility
            DIRECTIONAL_HARDWARE_SHADOWS : DirectionalHardwareShadows
            HEIGHTFIELD_SKY_IRRADIANCE : UseHeightfieldSkyIrradiance
        }

    }

    // Keep the depth pass on the same GPU-displaced surface as the lit pass.
    Technique PreShadow {
        VertexShader GLSL300 GLSL150: Common/MatDefs/Terrain/Heightfield/HeightfieldPreShadow.vert
        FragmentShader GLSL300 GLSL150: Common/MatDefs/Shadow/PreShadow.frag

        WorldParameters {
            WorldViewProjectionMatrix
        }

        Defines {
            HEIGHTFIELD_LOD : UseHeightfieldLod
            HEIGHTFIELD_INSTANCES : UseHeightfieldInstances
            HEIGHTFIELD_INSTANCE_MORPHS : UseHeightfieldInstanceMorphs
            HEIGHTFIELD_CPU_INSTANCES : UseHeightfieldCpuInstances
            HEIGHTFIELD_NODE_PAGES : UseHeightfieldNodePages
            HEIGHTFIELD_PATCH_RECORD_VECS : PatchRecordVectors
        }

        ForcedRenderState {
            FaceCull Off
            DepthTest On
            DepthWrite On
            PolyOffset 5 3
            ColorWrite Off
        }
    }
}
